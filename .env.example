# Copy this file to .env for local development. Never commit .env or API keys.
GEMINI_API_KEY=your-gemini-api-key
# Current default is a Gemini Flash model. Override only with a model enabled for your API key.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: increase/reduce number of retrieved CWE/CVE records (1-10).
RAG_TOP_K=5

# Evaluation API address (for scripts/evaluate.js)
EVALUATION_API_URL=http://localhost:8787
