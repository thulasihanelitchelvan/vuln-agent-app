{
  "name": "vuln-agent-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agentic AI vulnerability detection app — React frontend, Express/Node backend, Claude-powered agent pipeline.",
  "scripts": {
    "dev:server": "node server/local.js",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node server/local.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@google/genai": "^2.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
