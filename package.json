{
  "name": "vuln-agent-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gemini-powered agentic AI vulnerability detection and research evaluation system.",
  "scripts": {
    "dev:server": "node server/local.js",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node server/local.js",
    "test": "node --test tests/*.test.js",
    "evaluate": "node scripts/evaluate.js",
    "prepare:dataset": "python scripts/prepare_dataset.py",
    "import:cves": "python scripts/import_nvd_cves.py",
    "ablate": "node scripts/run_ablation_matrix.js"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
